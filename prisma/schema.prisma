// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
  TEMPORARY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum IdentificationType {
  NRC
  PASSPORT
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  PROBATION
  INTERNSHIP
  CONTRACTOR
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Organization {
  id             String       @id @default(cuid())
  name           String       @unique
  slug           String       @unique
  primaryColor   String?
  secondaryColor String?
  logo           String?
  isDefault      Boolean      @default(false)
  unlimitedLeave Boolean      @default(false)
  employees      Employee[]
  departments    Department[]
  leaveTypes     LeaveType[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("organizations")
}

model Department {
  id             String       @id @default(cuid())
  name           String
  description    String?
  managerId      String?      @unique
  manager        Employee?    @relation("DepartmentManager", fields: [managerId], references: [id])
  employees      Employee[]   @relation("DepartmentEmployees")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([name, organizationId])
  @@map("departments")
}

model Position {
  id          String     @id @default(cuid())
  title       String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("positions")
}

model Employee {
  id                   String              @id @default(cuid())
  employeeCode         String              @unique
  firstName            String
  lastName             String
  email                String              @unique
  personalEmail        String?
  passwordHash         String
  role                 Role                @default(EMPLOYEE)
  nickname             String?
  profilePicture       String?
  phone                String?
  gender               Gender?
  dateOfBirth          DateTime?
  nationality          String?
  identificationType   IdentificationType?
  identificationNumber String?             @unique
  countryId            String
  country              Country             @relation(fields: [countryId], references: [id])
  address              String?
  bankName             String?
  bankAccountNumber    String?
  hireDate             DateTime            @default(now())
  salary               Decimal             @db.Decimal(12, 2)
  status               EmploymentStatus    @default(ACTIVE)
  employmentType       EmploymentType      @default(FULL_TIME)
  departmentId         String?
  department           Department?         @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  managedDept          Department?         @relation("DepartmentManager")
  positionId           String?
  position             Position?           @relation(fields: [positionId], references: [id])
  managerId            String?
  manager              Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates         Employee[]          @relation("EmployeeManager")
  leaveRequests        LeaveRequest[]
  leaveBalances        LeaveBalance[]
  contracts            EmployeeContract[]
  documents            EmployeeDocument[]
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("employees")
}

model EmployeeContract {
  id           String         @id @default(cuid())
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractType ContractType
  startDate    DateTime
  endDate      DateTime?
  fileUrl      String?
  status       ContractStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("employee_contracts")
}

model EmployeeDocument {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType String
  fileUrl      String
  description  String?
  uploadedAt   DateTime @default(now())

  @@map("employee_documents")
}

model LeaveType {
  id               String         @id @default(cuid())
  name             String
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  daysPerYear      Int
  carryForward     Boolean        @default(false)
  maxCarryDays     Int            @default(0)
  restrictedGender Gender?
  description      String?
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([name, organizationId])
  @@map("leave_types")
}

model LeaveBalance {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  year          Int
  totalDays     Int
  usedDays      Int       @default(0)
  remainingDays Int

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  totalDays   Int
  reason      String?
  status      LeaveStatus @default(PENDING)
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leave_requests")
}

// Global, shared across every organization — not scoped by organizationId.
// No create/update/delete API; rows are added manually (e.g. once a year).
model PublicHoliday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  countryId   String
  country     Country  @relation(fields: [countryId], references: [id])
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, date])
  @@map("public_holidays")
}

model Country {
  id             String          @id @default(cuid())
  name           String          @unique
  code           String?         @unique
  employees      Employee[]
  publicHolidays PublicHoliday[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("countries")
}
